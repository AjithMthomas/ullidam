# Copy to .env.local for development. On Vercel, set these in
# Project Settings > Environment Variables. Never commit real values.

# Public configuration (inlined into the browser bundle at build time)
NEXT_PUBLIC_APP_NAME="Ullidam"
NEXT_PUBLIC_APP_URL="https://ullidam.com"
NEXT_PUBLIC_WHATSAPP_COORDINATOR="918590925353"

# Google Sheets engine (server only; wired up in Phases 3 and 4)
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Paste the key on one line with literal \n sequences for line breaks.
GOOGLE_PRIVATE_KEY=""
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=""

# Counsellor portal (server only; Phase 4). Use a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
COUNSELLOR_PORTAL_SECRET=""
