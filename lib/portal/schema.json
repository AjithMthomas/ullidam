    "ops": "Ullidam Operations",
    "vault": "Ullidam Clinical Vault"
  },
  "tabs": {
    "Clinicians": {
      "book": "ops",
      "columns": [
        "Clinician_ID",
        "Display_Name",
        "Slug",
        "Title",
        "Photo_URL",
        "Role",
        "Bio",
        "Approach",
        "Specialties",
