        "Draft_Approach",
        "Draft_Specialties",
        "Draft_Languages",
        "Profile_Status",
        "Profile_Note",
        "Active",
        "Row_Version",
        "Updated_At"
      ],
      "encrypted": []
    },
    "Clinician_Auth": {
      "book": "vault",
      "columns": [
        "Clinician_ID",
        "PIN_Hash",
        "Failed_Attempts",
        "Locked_Until",
