{
  "name": "ullidam-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-zero-emoji.mjs && next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "check:emoji": "node scripts/check-zero-emoji.mjs",
    "verify": "npm run check:emoji && npm run typecheck && npm run lint && npm run build",
    "portal:seed": "node scripts/portal-seed.mjs",
    "portal:setup-code": "node scripts/portal-setup-code.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "clsx": "2.1.1",
    "google-auth-library": "^10.9.1",
    "gsap": "3.15.0",
    "jose": "^6.2.18",
    "lenis": "1.3.26",
    "lucide-react": "1.68.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
